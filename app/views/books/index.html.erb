<%= render 'partial_template/header' %>

<main>
  <div class='book-post-list'>
    <div class="book-post-list-wrapper">
      <div class="book-post-list-heading">
        <h2>投稿一覧</h2>
      </div>
      <% if @books.any? %>
        <div class="book-post-images-container">
          <ul class="book-post-images slick-slider">
            <% @books.shuffle.each do |book| %>
              <li class="post-image">
                <%= link_to book_path(book.user_id), class: "book-card-link" do %>
                  <div class="book-card">
                    <div class="frame golden">
                      <div class="card-content-wrapper">
                        <div class="image-area">
                          <% if book.image.attached? %>
                            <%= image_tag book.image, class: "book-posted-image" %>
                          <% else %>
                            <%= image_tag "no-image.png", class: "book-posted-image no-exist" %>
                          <% end %>
                        </div>
                        
                        <div class="info-area">
                          <div class="title-plate">
                            <span class="book-title"><%= book.title %></span>
                          </div>
                          
                          <div class="hover-details">
                            <p class="category-tag"># <%= book.category.name %></p>
                            <ul class="content-list">
                              <% book.book_contents.take(2).each do |bc| %>
                                <li><%= bc.content %></li>
                              <% end %>
                              <% if book.book_contents.count > 2 %>
                                <li>…</li>
                              <% end %>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="empty-message">
          <p>投稿はありません</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class='app-description'>
    <div class="app-description-wrapper">
      <h2>本を読むと共に、発信する時代へ！</h2>
      <p>読書とSNSを融合させた近代的なアプリ</p>
      <p>50文字以内で本の内容をアウトプット可</p>
      <p>老若男女、どなたでも楽しめます。</p>
      <p class="app-download-text">アプリ版のダウンロードはこちら</p>
      <div class="store-btns">
        <%= link_to root_path do %>
          <%= image_tag("google-play-badge.png", class: "store-btn hovers", alt: "Google Playで手に入れよう") %>
        <% end %>
        <%= link_to root_path do %>
          <%= image_tag("apple-store-badge.png", class: "store-btn hovers", alt: "App Storeからダウンロード") %>
        <% end %>
      </div>
    </div>
  </div>

  <div class='app-feature'>
    <div class="app-feature-outer">
      <div class="app-feature-heading">
        <h2>アプリの特徴</h2>
      </div>
      <div class="app-feature-wrapper swiper">
        <div class="app-feature-contents swiper-wrapper">
          <div class="app-feature-container swiper-slide">
            <%= image_tag("bookshelves.png", class: "feature-image") %>
            <h2 class="app-feature-sentence">
              読んだ本の内容や感想を<br>最低50文字から投稿できます
            </h2>
          </div>

          <div class="app-feature-container swiper-slide">
            <%= image_tag("bookshelves.png", class: "feature-image") %>
            <h2 class="app-feature-sentence">
              新規登録はわずか3ステップで完了<br>SNS認証も可
            </h2>
          </div>

          <div class="app-feature-container swiper-slide">
            <%= image_tag("bookshelves.png", class: "feature-image") %>
            <h2 class="app-feature-sentence">
              印象に残った投稿に<br>コメント・高評価もつけられます
            </h2>
          </div>
        </div>
        <div class="pagination"></div>
      </div>
    </div>
  </div>

  <div class="faq">
    <div class='faq-wrapper'>
      <div class="faq-heading">
        <h2>よくある質問</h2>
      </div>
      <ul class="faq-list">
        <li class="question-and-answer">
          <h3 class="question">
            Q 費用はかかりますか？
          </h3>
          <span>+</span>
          <div class="answer">
            A 一切かかりません。無料でご利用いただけます。
          </div>
        </li>
        <li class="question-and-answer">
          <h3 class="question">
            Q 新規登録をしなくても利用できますか？
          </h3>
          <span>+</span>
          <div class="answer">
            <p>A 未登録でもご利用可能なサービスは以下の通りです。</p>
            <br>
            <p>・投稿閲覧</p>
            <p>・投稿検索</p>
            <br>
            <p>以下のサービスを利用したい場合は、新規登録とログインが必要です。</p>
            <br>
            <p>・新規投稿</p>
            <p>・コメント投稿</p>
            <p>・高評価</p>
            <p>・お気に入り追加</p>
          </div>
        </li>
        <li class="question-and-answer">
          <h3 class="question">
            Q 自分はよく読書する方ですが、レビューのように長文で感想を書ける自信がありません。
          </h3>
          <span>+</span>
          <div class="answer">
            A 無理に長文を書く必要はございません。数文字〜50文字書けば投稿可能です。
          </div>
        </li>
      </ul>
    </div>
  </div>
</main>

<%= link_to(new_book_path, class: "right-bottom-btn post hovers") do %>
  <span class="right-bottom-btn-text post">投稿する</span>
<% end %>

<%= render 'partial_template/footer' %>