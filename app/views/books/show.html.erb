<%= render 'partial_template/header' %>

<div class="white-background-color">
  <div class="detail-wrapper book-post-detail">
    <h1 class="post-detail-heading">
      投稿詳細
    </h1>

    <% @contents = @book.book_contents.to_a %>

    <div class="detail-container">
      <div class="detail-left">
        <% if current_user == @book.user %>
          <div class="posted-by-field is-mypage">
            <%= link_to user_path(current_user), class: "user-mypage-link" do %>
              <% if current_user.image.attached? %>
                <%= image_tag current_user.image, class: 'user-image posted-by hovers' %>
              <% else %>
                <%= image_tag "no-image.png", class: 'user-image posted-by no-exist hovers' %>
              <% end %>
              <span class="user-nickname posted-by hovers"><%= current_user.nickname %></span>
            <% end %>
          </div>
        <% else %>
          <div class="posted-by-field">
            <% if @book.user.image.attached? %>
              <%= image_tag @book.user.image, class: 'user-image posted-by' %>
            <% else %>
              <%= image_tag "no-image.png", class: 'user-image posted-by no-exist' %>
            <% end %>
            <span class="user-nickname posted-by"><%= @book.user.nickname %></span>
          </div>
        <% end %>

        <div class="content-item-field left-side vertical-text fade-in-up">
          <% [3, 5].each do |i| %>
            <% if @contents[i]&.content.present? %>
              <div class="content-item"><%= @contents[i].content %></div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="detail-center">
        <div class="book-card-static">
          <%# 一覧で使っている共通パーツをそのまま呼び出す %>
          <%= render 'partial_template/book_cards', book: @book, path_id: @book.user_id, frame_color: 'golden' %>
        </div>

        <div class="hashtags-area">
          <div class="category-hashtags-area">
            <% unless [0, 11, 12].include?(@book.category_id) %>
              <span class="category-tag" style="color: <%= @book.category.color %>;">
                # <%= @book.category.name %>
              </span>
            <% end %>
          </div>

          <div class="genre-hashtags-area">
            <% if @book.genres.present? %>
              <% @book.genres.each do |genre| %>
                <% unless [901].include?(genre.id) %>
                  <span class="genre-tag"># <%= genre.name %></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="content-item-field horizontal-text fade-in-up">
          <% [0, 1, 2].each do |i| %>
            <% if @contents[i]&.content.present? %>
              <div class="content-item"><%= @contents[i].content %></div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="detail-right">
        <div class="detail-right-upper">
          <% if user_signed_in? %>
            <ul class="detail-right-btn-field">
              <% if current_user == @book.user %>
                <li class="detail-right-btn hovers" id='post-edit-btn'>
                  <%= link_to "編集", edit_book_path(@book), class: 'detail-right-btn-text' %>
                </li>
                <li class="detail-right-btn hovers" id='destroy-post-btn' data-url="<%= book_path(@book) %>">
                  <span class="detail-right-btn-text">削除</span>
                </li>
              <% else %>
                <li class="detail-right-btn hovers">
                  <%= link_to "通報", root_path, class: 'detail-right-btn-text' %>
                </li>
              <% end %>
            </ul>
            <ul class="reaction-icon-field">
              <% unless current_user == @book.user %>
                <li>
                  <i class="fa-regular fa-thumbs-up hovers"></i>
                </li>
                <li>
                  <i class="fa-regular fa-thumbs-down hovers"></i>
                </li>
                <li>
                  <i class="fa-regular fa-star hovers"></i>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>

        <div class="content-item-field right-side vertical-text fade-in-up">
          <% [4, 6].each do |i| %>
            <% if @contents[i]&.content.present? %>
              <div class="content-item"><%= @contents[i].content %></div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="comment-wrapper">
      <% if user_signed_in? && current_user != @book.user %>
        <%= form_with model: [@book, @comment], local: false, class: "post-comment-wrapper" do |f| %>
          <div class="post-comment-container">
            <div class="post-comment-user-field">
              <% if current_user.image.attached? %>
               <%= image_tag current_user.image, class: 'user-image post-comment hovers' %>
              <% else %>
                <%= image_tag "no-image.png", class: 'user-image post-comment no-exist hovers' %>
              <% end %>
              <%= link_to user_path(current_user), class: 'comment-user-text' do %>
                <span class="user-nickname post-comment hovers"><%= current_user.nickname %></span>
              <% end %>
            </div>
            <div class="post-comment-field">
              <div class="comment-form">
                <%= f.text_field :text, class: "comment-form-text", maxlength: "100", placeholder: "コメントを100文字以内で入力" %>
                <p class="comment-caution-text">※批判的な意見はご遠慮ください</p>
              </div>
              <div class="comment-btn">
                <%= f.button type: "submit", class: "submit-comment-btn hovers" do %>
                  <i class="fa-solid fa-paper-plane"></i>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="posted-comment-list-container">
        <% if @comments.any? %>
          <p class="posted-comment-number">コメント <%= @comments.length %></p>
          <div class="posted-comment-list" id="js-comment-list">
            <%= render partial: 'partial_template/posted_comment_list', collection: @comments, as: :comment %>
          </div>
          <div class="view-more-comments-container" style="<%= 'display: none;' if @comments.length <= 10 %>">
            <p class="view-more-comments-text hovers" id="view-more-comments">コメントをもっと見る</p>
            <p class="hide-comments-text hovers" id="hide-comments" style="display: none;">折りたたむ</p>
          </div>
        <% else %>
          <div class="posted-comment-list" id="js-comment-list">
            <div class="empty-message none-comment">
              <p>コメントはありません</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div id="modal-overlay"></div>

<div class="modal finally-destroy">
  <div class="modal-wrapper finally-destroy">
    <div class="close-modal"><i class="fa-solid fa-xmark"></i></div>
    <p class="warning-text">本当に削除しますか？<br>一度削除すると復元できません。</p>
    <div class="destroy-really btn-on-center">
      <%= link_to "#", method: :delete, remote: true, class: "destroy-really-btn finally-destroy-link", id: "js-destroy-link" do %>
        <span class="destroy-really btn-text">本当に削除する</span>
      <% end %>
    </div>
    <div class="not-destroy btn-on-center">
      <span class="not-destroy btn-text">削除しない</span>
    </div>
  </div>
</div>

<%= render 'partial_template/return_btn' %>

<%= render 'partial_template/footer' %>