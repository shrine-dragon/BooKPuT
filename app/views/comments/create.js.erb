const commentContainer = document.querySelector('.posted-comment-list-container');

if (commentContainer) {
  const emptyMessage = commentContainer.querySelector('.none-comment');
  if (emptyMessage) {
    emptyMessage.remove();
  }

  const newCommentHtml = '<%= j render partial: "partial_template/posted_comment_list", locals: { comment: @comment } %>';
  commentContainer.insertAdjacentHTML('afterbegin', newCommentHtml);
}

const inputForm = document.querySelector('.comment-form-text');
const submitBtn = document.querySelector('.submit-comment-btn');

if (inputForm) {
  inputForm.value = '';
}

if (submitBtn) {
  submitBtn.disabled = false;
  submitBtn.removeAttribute('data-disable-with'); 

  submitBtn.classList.remove('is-show');
}

const flashContainer = document.getElementById('flash-container');
if (flashContainer) {
  flashContainer.innerHTML = `
    <% flash.each do |key, value| %>
      <div class="flash-message <%= key %>">
        <%= j value %>
      </div>
    <% end %>
  `;
  if (typeof window.fadeOutFlash === 'function') {
    window.fadeOutFlash();
  }
}