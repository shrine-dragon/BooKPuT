<%= render 'partial_template/header' %>

<div class="contact-page">
  <div class="static-page-wrapper">
    <h1 class="static-page-heading">お問い合わせ</h1>

    <div class="static-page-container">
      <%= form_with url: contacts_path, local: true do |f| %>
        
        <div class="form-group">
          <%= f.label :name, "氏名" %>
          <%= f.text_field :name, required: true %>
        </div>

        <div class="form-group">
          <%= f.label :email, "メールアドレス(任意)" %>
          <%= f.email_field :email %>
        </div>

        <div class="form-group">
          <%= f.label :subject, "題名(任意)" %>
          <%= f.text_field :subject %>
        </div>

        <div class="form-group">
          <%= f.label :message, "メッセージ本文" %>
          <%= f.text_area :message, required: true %>
        </div>

        <%= f.submit "送信" %>
      <% end %>
    </div>
  </div>
</div>

<%= render 'partial_template/return_btn' %>
<%= render 'partial_template/footer' %>