<%= render 'partial_template/second_header' %>

<%= render layout: 'password_reset_layout', locals: { title: '新しいパスワードの設定' } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'reset-password' }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div class="reset-password-text">
      <p>新しいパスワードを入力し、<br>｢変更する｣ボタンを押してください。</p>
    </div>
    <div class="form-text new-password">
      <label>新しいパスワード(必須)</label>
    </div>
    <%= f.password_field :password, class:"input-text new-password", id:"password", placeholder:"半角英数字8〜20文字以下", minlength:"8", maxlength:"20" %>
    <%= render "partial_template/error_messages", model: resource, attribute: :password %>

    <div class="form-text new-password">
      <label>新しいパスワード(確認用)</label>
    </div>
    <%= f.password_field :password_confirmation, class:"input-text new-password", id:"password_confirmation", placeholder:"同じパスワードを入力", minlength:"8", maxlength:"20" %>
    <%= render "partial_template/error_messages", model: resource, attribute: :password_confirmation %>

    <div class="form-btn-container">
      <%= f.submit "変更する", class: "cyan-submit-btn" %>
    </div>
  <% end %>
<% end %>

<%= render 'partial_template/return_btn' %>

<%= render 'partial_template/footer' %>