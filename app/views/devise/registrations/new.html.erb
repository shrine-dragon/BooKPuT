<%= render 'partial_template/second_header' %>

<%= form_with model: @user, url: user_registration_path, class: 'sign-up-form', local: true do |f| %>
  <div class="form-wrapper">
    <h1 class="form-heading">
      新規登録フォーム
    </h1>
    <div class="form-container">
      <div class="form-contents">
        <div class="form-text">
          <label>ニックネーム(必須)</label>
        </div>
        <%= f.text_field :nickname, class:"input-text", id:"nickname", placeholder:"3〜16文字以内", minlength:"3", maxlength:"16" %>
        <%= render "partial_template/error_messages", model: @user, attribute: :nickname %>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>画像(任意)</label>
        </div>
        <%= f.file_field :image, class:"upload-image custom-file-btn", id: "user_image" %>
        <div class="upload-image-list">
        </div>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>生年月日(必須)</label>
        </div>
        <div class="birth-date-wrapper">
          <%= f.date_field :birth_date, class: 'input-birth-date', id:"birth_date", max: Date.today %>
        </div>
        <%= render "partial_template/error_messages", model: @user, attribute: :birth_date %>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>性別(必須)</label>
        </div>
        <div class="gender-wrapper">
          <%= f.collection_select(:gender_id, Gender.all, :id, :name, {}, {class:"select-pull-down", id:"gender"}) %>
        </div>
        <%= render "partial_template/error_messages", model: @user, attribute: :gender_id %>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>メールアドレス(必須)</label>
        </div>
        <%= f.email_field :email, class:"input-text", id:"email", placeholder:"例：bookput@gmail.com" %>
        <%= render "partial_template/error_messages", model: @user, attribute: :email %>
      </div>

      <% if @sns_auth || session["devise.sns_auth"].present? %>
        <%= f.hidden_field :sns_auth_process, value: true %>
      <% end %>
        
      <% unless @sns_auth || session["devise.sns_auth"].present? %>
        <%# 通常の新規登録（メールアドレス）の時だけ表示する %>
        <div class="form-contents">
          <div class="form-text">
            <label>パスワード(必須)</label>
          </div>
          <%= f.password_field :password, class:"input-text", id:"password", placeholder:"半角英数字8〜20文字以下", minlength:"8", maxlength:"20" %>
          <%= render "partial_template/error_messages", model: @user, attribute: :password %>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>パスワード(確認用)</label>
          </div>
          <%= f.password_field :password_confirmation, class:"input-text", id:"password_confirmation", placeholder:"同じパスワードを入力してください", minlength:"8", maxlength:"20" %>
          <%= render "partial_template/error_messages", model: @user, attribute: :password_confirmation %>
        </div>
      <% end %>

      <div class="form-btn-container">
        <%= f.submit "登録する", class: "cyan-submit-btn" %>
      </div>
    </div>
  </div>
<% end %>

<%= render 'partial_template/return_btn' %>

<%= render 'partial_template/second_footer' %>