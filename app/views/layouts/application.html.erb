<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>BooKPuT</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script type="text/javascript" src="https://code.jquery.com/jquery-3.4.1.min.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/kenwheeler/slick@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/kenwheeler/slick@1.8.1/slick/slick-theme.css"/>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
  </head>

  <body class="<%= controller_name %>-<%= action_name %>" data-flash-alert="<%= flash[:alert] %>">
    <div id="flash-container">
      <% flash.each do |key, value| %>
        <% # 「ログインが必要です」というメッセージは、JSのトリガーにするだけで表示はしない %>
        <% if value == "ログインが必要です" %>
          <div class="flash-message <%= key %>" style="display: none;" data-auth-trigger="true">
            <%= value %>
          </div>
        <% else %>
          <div class="flash-message <%= key %>">
            <%= value %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="site-wrapper">
      <%= yield %>
    </div>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/gh/kenwheeler/slick@1.8.1/slick/slick.min.js"></script>

    <script>
      $(document).on('turbolinks:load', function() {
        $('.slick-slider').slick({
          autoplay: true,
          autoplaySpeed: 8000, // 10秒に設定
          speed: 1000,
          dots: false,
          arrows: true,
          slidesToShow: 3,
          slidesToScroll: 1,
          centerMode: false, // ★見切れを防ぐ
          infinite: true,
          pauseOnHover: true,
          responsive: [
                {
                  breakpoint: 1024,
                  settings: {
                    slidesToShow: 2
                  }
                },
                {
                  breakpoint: 600,
                  settings: {
                    slidesToShow: 1
                  }
                }
              ]
        });
      });
    </script>
  </body>
</html>