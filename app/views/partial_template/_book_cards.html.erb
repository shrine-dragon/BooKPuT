<li class="book-cards">
  <%= link_to book_path(book), class: "book-card-link" do %>
    <div class="book-card <%= local_assigns[:is_mini] ? 'is-mini' : '' %>">
      <%# indexはgolden、showはwhite %>
      <div class="frame <%= frame_color %>">
        <div class="card-content-wrapper">
          <div class="image-area">
            <% if book.image.attached? %>
              <%= image_tag book.image, class: "book-posted-image" %>
            <% else %>
              <%= image_tag "no-image.png", class: "book-posted-image no-exist" %>
            <% end %>
          </div>
          
          <div class="info-area">
            <div class="title-plate">
              <span class="book-title"><%= book.title %></span>
            </div>
            
            <div class="hover-details">
              <div class="category-hashtags-area">
                <% unless [0, 11, 12].include?(book.category_id) %>
                  <span class="category-tag" style="color: <%= book.category.color %>;">
                    # <%= book.category.name %>
                  </span>
                <% end %>
              </div>
              <div class="genre-hashtags-area">
                <% if book.genres.present? %>
                  <% book.genres.each do |genre| %>
                    <% unless [900, 901].include?(genre.id) %>
                      <span class="genre-tag"># <%= genre.name %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
              <div class="content-area">
                <ul class="content-list">
                  <% book.book_contents.take(2).each do |bc| %>
                    <li><%= bc.content %></li>
                  <% end %>
                  <%# 3つ目がある場合の「…」表示も共通化 %>
                  <% if book.book_contents.count > 2 %>
                    <li>…</li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</li>