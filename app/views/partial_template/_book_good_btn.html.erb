<% if BookGood.exists?(user_id: current_user.id, book_id: book.id) %>
  <% current_book_good = book.book_goods.find_by(user_id: current_user.id) %>
  <%= link_to book_good_path(book, current_book_good), method: :delete, remote: true, class: "good-link" do %>
    <i class="fa-solid fa-thumbs-up hovers posted-book" style="color: #ff9f00;"></i>
  <% end %>
<% else %>
  <%= link_to book_goods_path(book), method: :post, remote: true, class: "good-link" do %>
    <i class="fa-regular fa-thumbs-up hovers posted-book"></i>
  <% end %>
<% end %>

<% unless book.book_goods.count == 0 %>
  <span class="book-good-count"><%= book.book_goods.count %></span>
<% end %>