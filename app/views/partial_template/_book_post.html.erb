<%= form_with model: model, url: url, class: 'book-post', local: true do |f| %>
  <div class="white-background-color">
    <div class="form-wrapper book-post">
      <h1 class="form-heading">
        <%= title %>
      </h1>
      <div class="form-container">
        <div class="form-contents">
          <div class="form-text">
            <label>タイトル(必須)</label>
            <%= f.text_field :title, class:"input-text", id:"title-field", placeholder:"100文字以内", maxlength:"100" %>
            <%= render "partial_template/error_messages", model: model, attribute: :title %>
          </div>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>画像(任意)</label>
          </div>
          <%= f.file_field :image, class:"upload-image custom-file-btn hovers", id: "book-image" %>

          <%= f.hidden_field :delete_image, value: '0', id: 'delete-image-flag' %>

          <div class="upload-image-list">
            <% if is_edit && model.respond_to?(:image) && model.image.attached? %>
              <div class="image-preview-wrapper">
                <%= image_tag model.image, class: "preview-image" %>
                <span class="image-delete-btn">削除</span>
              </div>
            <% end %>
          </div>

          <div class="external-search-links">
            <%= link_to 'https://www.amazon.co.jp/s?k=' + (f.object.title || "本"), target: :_blank, rel: "noopener", class: "search-btn amazon", id: 'amazon-link' do %>
              <i class="fa-brands fa-amazon"></i> Amazonから探す
            <% end %>
            <%= link_to 'https://www.google.com/search?tbm=isch&q=' + (f.object.title || "本") + "+表紙", target: :_blank, rel: "noopener", class: "search-btn google", id: 'google-link' do %>
              <i class="fa-brands fa-google"></i> Googleから探す
            <% end %>
          </div>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>本の種類(必須)</label>
          </div>
          <div class="pull-down-wrapper">
            <%= f.collection_select(:category_id, Category.all, :id, :name, {}, {class:"select-pull-down", id:"category"}) %>
          </div>
          <%= render "partial_template/error_messages", model: model, attribute: :category_id %>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>内容(必須)</label>
          </div>

          <div id="contents-container">
            <%= f.fields_for :book_contents do |content_form| %>
              <div class="content-field">
                <%= content_form.text_field :content, class:"input-text", placeholder:"20〜50文字以内" %>

                <% if content_form.index == 0 %>
                  <%= render "partial_template/error_messages", model: content_form.object, attribute: :content %>
                <% end %>
              </div>
            <% end %>
          </div>

          <span type="button" id="add-content-btn" class="plus-btn hovers">
            <i class="fa-solid fa-plus"></i> 項目を追加する (最大6つ)
          </span>
        </div>

        <div class="form-btn-container">
          <%= f.submit btn_text, class: "orange-submit-btn hovers" %>
        </div>
      </div>
    </div>
  </div>
<% end %>