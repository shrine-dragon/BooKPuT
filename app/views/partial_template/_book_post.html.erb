<%= form_with model: model, url: url, class: 'book-post', local: true do |f| %>
  <div class="white-background-color">
    <div class="form-wrapper book-post">
      <h1 class="form-heading">
        <%= title %>
      </h1>
      <div class="form-container">
        <div class="form-contents">
          <div class="form-text">
            <label>タイトル(必須)</label>
            <%= f.text_field :title, class:"input-text", id:"title", placeholder:"100文字以内", maxlength:"100" %>
            <%= render "partial_template/error_messages", model: model, attribute: :title %>
          </div>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>画像(任意)</label>
          </div>
          <%= f.file_field :image, class:"upload-image hovers", id: "book-image" %>
          <%= f.hidden_field :remote_image_url, id: "remote-image-url" %>

          <% if model.errors.any? %>
            <p class="image-re-select-message" >
              画像を選択し直してください
            </p>
          <% end %>

          <div class="upload-image-list" id="preview-image-container" >
            <% if model.image.attached? && model.image.persisted? %>
              <div class="preview-image-wrapper">
               <%= image_tag model.image, class: "preview-image" %>
               <%= f.hidden_field :image, value: model.image.signed_id %>
               <span class="delete-image-btn">削除</span>
              </div>
            <% else %>
              <div id="client-side-preview"></div>
            <% end %>
          </div>

          <%= f.hidden_field :delete_image, value: '0', id: 'delete-image-flag' %>

          <div class="external-search-links">
            <span id="api-search-btn" class="external-search-btn api hovers" data-api-key="<%= ENV['GOOGLE_BOOKS_API_KEY'] %>">書籍を自動検索</span>
            <div id="search-results-modal" style="display: none;">
              <div class="modal-content">
                <div class="modal-header">
                  <h3>検索結果から選択</h3>
                  <span id="close-modal" class="close-btn">&times;</span>
                </div>
                <div id="search-results-list" class="results-grid">
                </div>
              </div>
            </div>

            <%= link_to 'https://www.amazon.co.jp/s?k=' + (f.object.title || "本"), target: :_blank, rel: "noopener", class: "external-search-btn amazon hovers", id: 'amazon-link' do %>
              <i class="fa-brands fa-amazon"></i> Amazonから探す
            <% end %>
            <%= link_to 'https://www.google.com/search?tbm=isch&q=' + (f.object.title || "本") + "+表紙", target: :_blank, rel: "noopener", class: "external-search-btn google hovers", id: 'google-link' do %>
              <i class="fa-brands fa-google"></i> Googleから探す
            <% end %>
          </div>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>本の種類(必須)</label>
            <div class="pull-down-wrapper">
              <%= f.collection_select(:category_id, Category.all, :id, :name, {}, {class:"select-pull-down", id:"category"}) %>
            </div>
            <%= render "partial_template/error_messages", model: model, attribute: :category_id %>
          </div>
        </div>

        <div class="form-contents">
          <div class="form-text">
            <label>内容(1項目以上、入力必須)</label>
          </div>

          <div id="contents-container">
            <%= f.fields_for :book_contents, model.book_contents do |content_form| %>
              <div class="content-field">
                <div class="input-main-part" style="flex: 1;">
                  <%= content_form.text_field :content, id: "book_content_#{content_form.index}", class:"input-text", placeholder:"50文字以内" %>
                </div>
                <span class="remove-content-btn hovers" >−</span>
              </div>
            <% end %>
            <%= render "partial_template/error_messages", model: model, filter: "内容" %>
          </div>

          <span type="button" id="add-content-btn" class="plus-btn hovers">
            ＋</i> 項目を追加する<span id="remaining-count">(残り<%= 7 - model.book_contents.length %>項目)</span>
          </span>
        </div>

        <div class="form-btn-container">
          <%= f.submit btn_text, class: "orange-submit-btn hovers" %>
        </div>
      </div>
    </div>
  </div>
<% end %>