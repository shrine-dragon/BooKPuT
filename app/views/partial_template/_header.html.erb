<div class="header">
  <div class="header-wrapper">
    <div class="header-logo">
      <%= link_to root_path do %>
        <%= image_tag("BooKPuT-logo.png", class: "bookput-header-logo") %>
      <% end %>
    </div>
    <div class="header-list">
      <div class="search">
        <input type="text" class="search-bar" placeholder=" キーワードを入力してください" maxlength="50">
        <input type="submit" class="search-btn">
      </div>
      <ul class="header-btns">
        <li class="log-in-btn">
          <%= link_to "#", class: "log-in-show-btn" do %>
            <span class="log-in-btn-text">ログイン</span>
          <% end %>
        </li>
        <li class="sign-up-btn">
          <%= link_to "#", class: "sign-up-show-btn" do %>
            <span class="sign-up-btn-text">新規登録</span>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</div>

<div id="modal-overlay"></div>

<div class="modal log-in">
  <div class="modal-wrapper log-in">
    <%= form_with model: @user, url: user_session_path, local: true do |f| %>
      <div class="modal-btn-container log-in">
        <div class="log-in-form">
          <label class="log-in-form-text">メールアドレス</label>
          <%= f.email_field :email, class: "input-mail-address", id: 'email' %>
          <label class="log-in-form-text">パスワード</label>
          <%= f.password_field :password, class: "input-password", id: 'password' %>
          <%= f.submit "ログイン", class: "log-in-submit-btn" %>
          <p><%= link_to 'パスワードをお忘れですか？', "#", class: "forget-password", id: "underline-text" %></p>
        </div>
      </div>
      <div class="two-columns-layout">
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-google"></i>Googleで続ける
        <% end %>
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-x-twitter"></i>X(Twitter)で続ける
        <% end %>
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-facebook"></i>Facebookで続ける
        <% end %>
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-line"></i>LINEで続ける
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="modal sign-up">
  <div class="modal-wrapper sign-up">
    <div class="modal-btn-container sign-up">
      <%= link_to(user_registration_path, class: "modal-btn") do %>
        <i class="fa-regular fa-envelope"></i>メールアドレスでアカウント作成
      <% end %>
      <div class="two-columns-layout">
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-google"></i>Google
        <% end %>
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-x-twitter"></i>X(Twitter)
        <% end %>
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-facebook"></i>Facebook
        <% end %>
        <%= link_to(root_path, class: "modal-btn") do %>
          <i class="fa-brands fa-line"></i>LINE
        <% end %>
      </div>
    </div>
  </div>
</div>