<div class="modal log-in">
  <div class="close-modal"><i class="fa-solid fa-xmark"></i></div>

  <div class="modal-wrapper log-in">
    <%= form_with scope: :user, url: user_session_path, local: true do |f| %>
      <div class="modal-btn-container log-in">
        <div class="log-in-form">
          <label class="log-in-form-text">メールアドレス</label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-mail-address", id: 'email' %>

          <div class="log-in-password">
            <label class="log-in-form-text">パスワード</label>
            <%= f.password_field :password, autocomplete: "current-password", class: "input-password", id: 'password' %>
            <i class="fa-regular fa-eye-slash toggle-password"></i>
          </div>

          <%= f.submit "ログイン", class: "log-in-submit-btn hovers" %>
          <p><%= link_to 'パスワードをお忘れですか？', new_user_password_path, class: "forget-password", class: "underline-text" %></p>
        </div>
      </div>
      <div class="two-columns-layout">
        <%= link_to(user_google_oauth2_omniauth_authorize_path, class: "modal-btn hovers", id:"google-log-in", method: :post) do %>
          <i class="fa-brands fa-google"></i>Google<span class="sns-log-in-text pc-only">で続ける</span>
        <% end %>
        <%= link_to(user_twitter_omniauth_authorize_path, class: "modal-btn hovers", id: "twitter-log-in", method: :post) do %>
          <i class="fa-brands fa-x-twitter"></i>X(Twitter)<span class="sns-log-in-text pc-only">で続ける</span>
        <% end %>
        <%= link_to(user_facebook_omniauth_authorize_path, class: "modal-btn hovers", id: "facebook-log-in", method: :post) do %>
          <i class="fa-brands fa-facebook"></i>Facebook<span class="sns-log-in-text pc-only">で続ける</span>
        <% end %>
        <%= link_to(user_line_omniauth_authorize_path, class: "modal-btn hovers", id: "line-log-in", method: :post) do %>
          <i class="fa-brands fa-line"></i>LINE<span class="sns-log-in-text pc-only">で続ける</span>
        <% end %>
      </div>
      <p class="urge-sign-up log-in-modal-footer">新規登録は<span><%= link_to 'こちら', new_user_registration_path, class: "sign-up-here", class: "underline-text" %></span></p>
    <% end %>
  </div>
</div>