<%= form_with model: model, url: url, class: 'sign-up-or-edit', local: true do |f| %>
  <div class="form-wrapper">
    <h2 class="form-heading">
      <%= title %>
    </h2>
    <div class="form-container">
      <div class="form-contents">
        <div class="form-text">
          <label>ニックネーム(必須)</label>
        </div>
        <%= f.text_field :nickname, class: "input-text", id: "nickname", placeholder: "16文字以内", maxlength: "16" %>
        <%= render "partial_template/error_messages", model: @user, attribute: :nickname %>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>画像(任意)</label>
        </div>
        <%= f.file_field :image, class:"upload-image hovers", id: "user-image" %>
        
        <%= f.hidden_field :delete_image, value: '0', id: 'delete-image-flag' %>

        <div class="upload-image-list" id="preview-image-container">
          <% if is_edit && model.image.attached? %>
            <div class="preview-image-wrapper">
              <%= image_tag model.image, class: "preview-image" %>
              <span class="delete-image-btn">削除</span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>生年月日(必須)</label>
        </div>
        <div class="birth-date-wrapper">
          <%= f.date_field :birth_date, class: 'input-birth-date', id:"birth_date", max: Date.today %>
        </div>
        <%= render "partial_template/error_messages", model: @user, attribute: :birth_date %>
      </div>

      <div class="form-contents">
        <div class="form-text">
          <label>性別(必須)</label>
        </div>
        <div class="pull-down-wrapper">
          <%= f.collection_select(:gender_id, Gender.all, :id, :name, {}, {class: "select-pull-down", id: "gender"}) %>
        </div>
        <%= render "partial_template/error_messages", model: @user, attribute: :gender_id %>
      </div>

      <div class="form-contents">
        <% unless is_edit %>
          <div class="form-text">
            <label>メールアドレス(必須)</label>
          </div>
          <%= f.email_field :email, class: "input-text", id: "email", placeholder: "bookput@gmail.com" %>
          <%= render "partial_template/error_messages", model: @user, attribute: :email %>
        <% end %>
      </div>

      <% if @sns_auth || session["devise.sns_auth"].present? %>
        <%= f.hidden_field :sns_auth_process, value: true %>
      <% end %>
        
      <% unless is_edit || @sns_auth || session["devise.sns_auth"].present? %>
        <%# 通常の新規登録（メールアドレス）の時だけ表示する %>
        <div class="form-contents register-password">
          <div class="form-text">
            <label>パスワード(必須)</label>
          </div>
          <%= f.password_field :password, class: "input-text", id: "password", placeholder: "半角英数字8〜20文字以内", minlength: "8", maxlength: "20" %>
          <i class="fa-regular fa-eye-slash toggle-password"></i>

          <%= render "partial_template/error_messages", model: @user, attribute: :password %>
        </div>

        <div class="form-contents register-password">
          <div class="form-text">
            <label>パスワード(確認用)</label>
          </div>

          <%= f.password_field :password_confirmation, class: "input-text", id: "password_confirmation", placeholder: "同じパスワードを入力", minlength: "8", maxlength:"20" %>
          <i class="fa-regular fa-eye-slash toggle-password"></i>

          <%= render "partial_template/error_messages", model: @user, attribute: :password_confirmation %>
        </div>
      <% end %>

      <div class="form-btn-container">
        <%= f.submit btn_text, class: "orange-submit-btn hovers" %>
      </div>
      
      <div class="smp-only">
        <p class="urge-log-in">ログインは<span class="log-in-here underline-text hovers">こちら</span></p>
      </div>
    </div>
  </div>
<% end %>

<div class="smp-only">
  <%= render 'partial_template/footer' %>
</div>