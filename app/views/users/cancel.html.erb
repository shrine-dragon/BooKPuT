<%= render 'partial_template/second_header' %>

<div class="destroy-account">
  <%= render layout: 'partial_template/destroy_account_layout', locals: { title: 'アカウント削除' } do %>
    <h2 class="select-reason-destroy-account">※解約理由を以下から選択してください(複数可)。</h2>
    <ul class="reasons-to-destroy-account">
      <li>
        <label><%= check_box_tag :reason1 %>間違えて登録した</label>
      </li>
      <li>
        <label><%= check_box_tag :reason2 %>そもそも本を読まない</label>
      </li>
      <li>
        <label><%= check_box_tag :reason3 %>利用したがつまらなかった</label>
      </li>
      <li>
        <label><%= check_box_tag :reason4 %>その他(以下のフォームに自由にご記入ください)</label>
      </li>
    </ul>
    <div class="dummy-text-area">
      <%= text_area_tag :dummy_feedback, nil, placeholder: "自由記述欄（最大500文字）", maxlength: 500, class: "feedback-form" %>
    </div>

    <div class="continue-account btn-on-center">
      <%= link_to(root_path, class: "continue-account-btn") do %>
        <span class="continue_account btn-text">利用を継続する</span>
      <% end %>
    </div>
    <div class="destroy-account btn-on-center">
      <%= link_to(user_path(@user), method: :delete, class: "destroy-account-btn") do %>
        <span class="destroy_account btn-text">アカウントを解約する</span>
      <% end %>
    </div>
  <% end %>
</div>

<%= render 'partial_template/return_btn' %>

<%= render 'partial_template/footer' %>